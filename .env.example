# CAREST 360 review / production contract
NODE_ENV=development
PORT=3000

# PostgreSQL (production API)
DATABASE_URL=postgresql://carest:carest_dev_password@localhost:5432/carest?schema=public
DIRECT_URL=postgresql://carest:carest_dev_password@localhost:5432/carest?schema=public

# Redis (optional in the review slice)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally; change endpoints per provider)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=carest-private
STORAGE_ACCESS_KEY=carest
STORAGE_SECRET_KEY=carest_dev_storage_password
STORAGE_FORCE_PATH_STYLE=true

# Auth / security — generate unique production values, never commit them
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-second-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=finance-admin@carestcollegeofhealth.edu.gh
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Email / SMS adapters (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=

# Institution defaults — confirm with CAREST before launch
INSTITUTION_NAME=CAREST College of Health
INSTITUTION_TIMEZONE=Africa/Accra
INSTITUTION_CURRENCY=GHS
